#!/usr/bin/env bash
# NeoGate pre-commit hook: keep Rust formatting aligned with CI.
# Mirrors the "Check formatting" step in .github/workflows/ci.yml so that
# formatting failures never reach the CI runner.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not found on PATH, skipping rustfmt check." >&2
  exit 0
fi

# Only run when Rust sources are staged.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^backend/.*\.rs$|^scheduler/.*\.rs$'; then
  echo "pre-commit: running 'cargo fmt --all -- --check' ..." >&2
  if ! cargo fmt --all -- --check; then
    echo "" >&2
    echo "pre-commit: rustfmt check failed (see diff above)." >&2
    echo "  fix:   cargo fmt --all" >&2
    echo "  then:  git add -u && git commit" >&2
    exit 1
  fi
fi
