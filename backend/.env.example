# Required
DATABASE_URL=postgres://localhost/neogate
PUBLIC_BASE_URL=http://127.0.0.1:8080
SITE_NAME=NeoGate
ADMIN_TOKEN_SECRET=change-me-admin-token-secret-in-production
UPSTREAM_SECRET_KEY=change-me-upstream-secret-key-in-production

# Docker Compose only
# POSTGRES_PASSWORD=change-me-postgres-password
# POSTGRES_DB=neogate
# POSTGRES_USER=neogate
# BACKEND_PORT=8080

# Common optional settings
# BIND_ADDR=127.0.0.1:8080
# CORS_ALLOWED_ORIGINS=*
# ADMIN_SESSION_TTL_SECONDS=86400
# Set to true when running behind a reverse proxy (e.g. nginx) that sets
# X-Forwarded-For / X-Real-IP, so auth rate limiting keys on the real client IP.
# TRUST_PROXY_HEADERS=false

# Deployment mode
# RUNTIME_MODE=standalone
# PROCESS_ROLE=all
# REDIS_URL=redis://127.0.0.1:6379/
# REDIS_KEY_PREFIX=neogate

# Request and database limits
# REQUEST_TIMEOUT_SECONDS=120
# RELAY_BODY_LIMIT_BYTES=16777216
# CREDENTIAL_UPLOAD_LIMIT_BYTES=10485760
# DB_POOL_MAX_CONNECTIONS=10
# 2GB server high-throughput queue baseline.
# USAGE_QUEUE_SIZE=32768
# USAGE_FLUSH_INTERVAL_MS=200
