APP_ENV=production
RUNTIME_MODE=distributed

# Shared external state services. Do not point these at per-node local services.
DATABASE_URL=postgres://neogate:change-me@postgres.example.com:5432/neogate
REDIS_URL=redis://redis.example.com:6379/
REDIS_KEY_PREFIX=neogate

# Public site identity.
SITE_NAME=NeoGate
PUBLIC_BASE_URL=https://neogate.example.com
CORS_ALLOWED_ORIGINS=https://neogate.example.com

# Generate long random values and keep them identical for every API/worker node.
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-shared-admin-token-secret
UPSTREAM_SECRET_KEY=change-me-to-a-long-random-shared-upstream-secret-key

# Optional web port when using docker compose directly.
WEB_PORT=8080

# Optional tuning.
# DB_POOL_MAX_CONNECTIONS=10
# REQUEST_TIMEOUT_SECONDS=120
# RELAY_BODY_LIMIT_BYTES=16777216
# CREDENTIAL_UPLOAD_LIMIT_BYTES=10485760
