# NeoGate installed with:
#   docker compose up -d --build
#
# Docker Compose exposes the frontend nginx container on WEB_PORT, which defaults
# to 8080. This host-level nginx config only needs to reverse proxy the whole
# site to that port; the container nginx will serve static files and route API
# paths to the backend service.

# Forward WebSocket upgrade headers only when the client asks for a protocol
# upgrade (e.g. /v1/realtime); plain HTTP requests get Connection: close.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name example.com;

    # Increase this if clients send large model requests, image edits, file
    # content, or long contexts.
    client_max_body_size 64m;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Keep streaming APIs responsive and allow long-running model/image requests.
        proxy_buffering off;
        proxy_request_buffering off;
        add_header X-Accel-Buffering no always;
        proxy_connect_timeout 60s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        send_timeout 1200s;

        proxy_pass http://127.0.0.1:8080;
    }
}

# If you terminate TLS on the host, use this shape instead:
#
# server {
#     listen 80;
#     server_name example.com;
#     return 301 https://$host$request_uri;
# }
#
