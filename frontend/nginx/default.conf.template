# Forward WebSocket upgrade headers only when the client asks for a protocol
# upgrade (e.g. /v1/realtime); plain HTTP requests get Connection: close.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;

    # Required for Docker overlay2: sendfile can return empty responses
    # when the file sits on a different filesystem layer.
    sendfile off;

    client_max_body_size 64m;

    root /usr/share/nginx/html;
    index index.html;

    location ~ ^/(api|apps|widget|v1|anthropic|readyz|livez|install(?:\.ps1)?)(/|$) {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Keep streaming APIs responsive and allow long-running model/image requests.
        proxy_buffering off;
        proxy_request_buffering off;
        add_header X-Accel-Buffering no always;
        proxy_connect_timeout 60s;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        send_timeout 1200s;

        # Use variable to defer DNS resolution so nginx doesn't crash if backend isn't ready at startup
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $backend_upstream ${API_UPSTREAM};
        proxy_pass $backend_upstream;
    }

    location / {
        try_files $uri /index.html;
    }
}
