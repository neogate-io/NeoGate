# 应用
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=*
RUNTIME_MODE=standalone
PROCESS_ROLE=all

# 数据库
DATABASE_URL=postgres://localhost/moligate
POSTGRES_DB=moligate
POSTGRES_USER=moligate
POSTGRES_PASSWORD=change-me-postgres-password

# 管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_TOKEN_SECRET=change-me-admin-token-secret-in-production
ADMIN_SESSION_TTL_SECONDS=86400

# 转发
UPSTREAM_SECRET_KEY=change-me-upstream-secret-key-in-production
ANTHROPIC_VERSION=2023-06-01
CREDENTIAL_UPLOAD_LIMIT_BYTES=10485760

# 邮件
MAIL_SMTP_HOST=smtp.example.com
MAIL_FROM_EMAIL=noreply@example.com
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_NAME=
MAIL_SUBJECT_PREFIX=

# 支付
# 启用的支付网关，多个用英文逗号分隔。配置 zpay 后可使用 ZPAY 收银台。
PAYMENT_PROVIDERS=zpay
# 后端公网地址，用于支付网关回调。
PAYMENT_RETURN_BASE_URL=https://api.example.com
ZPAY_API_URL=https://zpayz.cn/submit.php
ZPAY_MERCHANT_ID=
ZPAY_SECRET_KEY=
ZPAY_DEFAULT_PAY_TYPE=wxpay
ZPAY_SITE_NAME=Moligate

# 高级可选调优

# 安全和进程模式
# 运行模式：standalone 适合单后端进程；distributed 适合多副本集群，并要求配置 Redis。
# RUNTIME_MODE=distributed
# 进程角色：all 同时提供 HTTP 和后台 worker；api 只提供 HTTP；worker 只运行后台任务。
# PROCESS_ROLE=all

# Redis 运行时状态
# distributed 模式下的 Redis 地址，用于热余额和跨实例缓存失效。
# REDIS_URL=redis://127.0.0.1:6379/
# Redis key 和 pub/sub channel 前缀。多个环境共用 Redis 时应设置不同前缀。
# REDIS_KEY_PREFIX=moligate

# 账务恢复
# active credit allocation 超过多少秒未结算后进入恢复流程。
# CREDIT_ALLOCATION_RECOVERY_AFTER_SECONDS=900
# stale credit allocation 扫描间隔。
# CREDIT_ALLOCATION_RECOVERY_INTERVAL_SECONDS=60
# 转发请求未指定输出 token 上限时插入的默认值。
# DEFAULT_OUTPUT_TOKENS=2048

# 数据库和上游网络
# 每个后端进程的 PostgreSQL 最大连接数。
# DB_POOL_MAX_CONNECTIONS=10
# 上游 key 失败后的冷却时间。
# KEY_COOLDOWN_SECONDS=60
# 上游请求端到端超时时间。
# REQUEST_TIMEOUT_SECONDS=120
# 转发接口接受的最大 JSON 请求体大小。
# RELAY_BODY_LIMIT_BYTES=16777216
# 每个上游 host 保留的最大空闲 HTTP 连接数。
# HTTP_POOL_MAX_IDLE_PER_HOST=100
# 上游空闲 HTTP 连接在连接池中的保留时间。
# HTTP_POOL_IDLE_TIMEOUT_SECONDS=90

# 进程内缓存
# 下游 API key 认证的进程内缓存 TTL。
# USER_AUTH_CACHE_TTL_SECONDS=10
# 渠道和上游 key 路由信息的进程内缓存 TTL。
# ROUTING_CACHE_TTL_SECONDS=10
# provider/model 价格的进程内缓存 TTL。
# PRICE_CACHE_TTL_SECONDS=30

# Usage 和 billing outbox
# 非账务 usage 批量 flush 间隔。
# USAGE_FLUSH_INTERVAL_MS=1000
# 非账务 usage 事件的进程内队列大小。
# USAGE_QUEUE_SIZE=8192
# durable billing pending 数量超过该值时，/readyz 返回 unhealthy。
# BILLING_OUTBOX_MAX_PENDING=10000
# 最老的 pending billing 超过该秒数时，/readyz 返回 unhealthy。
# BILLING_OUTBOX_MAX_AGE_SECONDS=300
