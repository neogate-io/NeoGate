# Standalone Docker Compose defaults.
# Copy this file to the project root as .env before running docker compose.
# Change POSTGRES_PASSWORD before production use.
POSTGRES_PASSWORD=neogate-change-me
POSTGRES_DB=neogate
POSTGRES_USER=neogate
WEB_PORT=8080

# Used by the frontend installer script and public callbacks.
# The first-run wizard can also write SITE_NAME / PUBLIC_BASE_URL into the backend config volume.
SITE_NAME=NeoGate
PUBLIC_BASE_URL=http://localhost:8080

# 2GB server high-throughput queue baseline.
USAGE_QUEUE_SIZE=32768
USAGE_FLUSH_INTERVAL_MS=200
