# App
APP_ENV=development
BIND_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=*
PROCESS_ROLE=all

# Database
DATABASE_URL=postgres://localhost/neogate
POSTGRES_DB=neogate
POSTGRES_USER=neogate
POSTGRES_PASSWORD=change-me-postgres-password

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_TOKEN_SECRET=change-me-admin-token-secret-in-production
ADMIN_SESSION_TTL_SECONDS=86400

# Relay
UPSTREAM_SECRET_KEY=change-me-upstream-secret-key-in-production
ANTHROPIC_VERSION=2023-06-01
CREDENTIAL_UPLOAD_LIMIT_BYTES=10485760

# Mail
MAIL_SMTP_HOST=smtp.example.com
MAIL_FROM_EMAIL=noreply@example.com
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_NAME=
MAIL_SUBJECT_PREFIX=

# Payments
# Comma-separated enabled payment providers. Use zpay to enable ZPAY checkout.
PAYMENT_PROVIDERS=zpay
# Public backend base URL used by payment providers to send callbacks.
PAYMENT_RETURN_BASE_URL=https://api.example.com
ZPAY_API_URL=https://zpayz.cn/submit.php
ZPAY_MERCHANT_ID=
ZPAY_SECRET_KEY=
ZPAY_DEFAULT_PAY_TYPE=wxpay
ZPAY_SITE_NAME=NeoGate

# Advanced optional tuning

# Safety and process mode
# Runtime mode. Use standalone for one backend process, distributed for multiple replicas with Redis.
# RUNTIME_MODE=distributed
# Process role: all serves HTTP and runs workers; api serves HTTP only; worker runs background jobs only.
# PROCESS_ROLE=all

# Redis runtime state
# Redis endpoint used in distributed mode for hot credit and cache invalidation.
# REDIS_URL=redis://127.0.0.1:6379/
# Prefix for Redis keys and pub/sub channels. Change it when sharing one Redis across environments.
# REDIS_KEY_PREFIX=neogate

# Billing recovery
# Recover active credit allocations that have not been finalized after this many seconds.
# CREDIT_ALLOCATION_RECOVERY_AFTER_SECONDS=900
# Interval for scanning stale credit allocations.
# CREDIT_ALLOCATION_RECOVERY_INTERVAL_SECONDS=60
# Default output token limit inserted when a relay request does not specify one.
# DEFAULT_OUTPUT_TOKENS=2048

# Database and upstream networking
# Maximum PostgreSQL connections per backend process.
# DB_POOL_MAX_CONNECTIONS=10
# How long a failed upstream key stays in cooldown.
# KEY_COOLDOWN_SECONDS=60
# End-to-end upstream request timeout.
# REQUEST_TIMEOUT_SECONDS=120
# Maximum JSON request body size accepted by relay endpoints.
# RELAY_BODY_LIMIT_BYTES=16777216
# Maximum idle HTTP connections kept per upstream host.
# HTTP_POOL_MAX_IDLE_PER_HOST=100
# How long idle upstream HTTP connections stay in the pool.
# HTTP_POOL_IDLE_TIMEOUT_SECONDS=90

# In-process caches
# In-process downstream API key auth cache TTL.
# USER_AUTH_CACHE_TTL_SECONDS=10
# In-process channel/key routing cache TTL.
# ROUTING_CACHE_TTL_SECONDS=10
# In-process provider price cache TTL.
# PRICE_CACHE_TTL_SECONDS=30

# Usage and billing outbox
# Interval for flushing non-billing usage batches.
# USAGE_FLUSH_INTERVAL_MS=1000
# In-process queue size for non-billing usage events.
# USAGE_QUEUE_SIZE=8192
# Readiness fails when pending durable billing records exceed this count.
# BILLING_OUTBOX_MAX_PENDING=10000
# Readiness fails when the oldest pending billing record is older than this many seconds.
# BILLING_OUTBOX_MAX_AGE_SECONDS=300
